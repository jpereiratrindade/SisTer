{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.dev/contracts/context-reference/1.0.0/context-reference.schema.json",
  "title": "SisTer Context Reference",
  "description": "Referência opaca a uma identidade pertencente a uma autoridade de domínio.",
  "type": "object",
  "required": [
    "schema",
    "refs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "sister.context-reference/1.0.0"
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": [
        "authority",
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  }
}
