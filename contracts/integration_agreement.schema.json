{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.local/contracts/integration_agreement.schema.json",
  "title": "SisTer Integration Agreement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "profile",
    "agreement_id",
    "revision",
    "proposer_system_id",
    "counterparty_system_id",
    "identity_mode",
    "capabilities"
  ],
  "properties": {
    "protocol_version": {"const": "sister.integration-agreement/1.0.0"},
    "profile": {"type": "string", "pattern": "^[a-z0-9-]+\\.profile/[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "agreement_id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "proposer_system_id": {"type": "string", "minLength": 1},
    "counterparty_system_id": {"type": "string", "minLength": 1},
    "identity_mode": {"enum": ["local", "shared_provider", "federated"]},
    "identity_provider": {"type": "string"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "direction",
        "requirement",
        "decision",
        "purpose",
        "schema_ref",
        "operations",
        "requested_constraints",
        "accepted_constraints"
      ],
      "properties": {
        "capability_id": {"type": "string", "minLength": 1},
        "direction": {"enum": ["proposer_to_counterparty", "counterparty_to_proposer"]},
        "requirement": {"enum": ["required", "optional"]},
        "decision": {"enum": ["requested", "accepted", "accepted_with_constraints", "declined"]},
        "purpose": {"type": "string", "minLength": 1},
        "schema_ref": {"type": "string", "minLength": 1},
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "requested_constraints": {"type": "object"},
        "accepted_constraints": {"type": "object"},
        "decision_reason": {"type": "string"}
      }
    }
  }
}
