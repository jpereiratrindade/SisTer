{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.local/contracts/sister_clima_governance.schema.json",
  "title": "SisTer Sister-Clima Governance Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "system_id",
    "effective_date",
    "purpose",
    "access",
    "commercial_use",
    "data_sources",
    "output_policy",
    "software_distribution",
    "audit"
  ],
  "properties": {
    "contract_id": { "const": "sister-clima.governance" },
    "contract_version": { "const": "1.0.0" },
    "system_id": { "const": "sister_clima" },
    "effective_date": { "type": "string", "format": "date" },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "description", "permitted_contexts", "prohibited_contexts"],
      "properties": {
        "classification": { "const": "non_commercial_public_research" },
        "description": { "type": "string", "minLength": 1 },
        "permitted_contexts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "prohibited_contexts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience",
        "entry_authentication",
        "direct_url_publication",
        "origin_protection",
        "current_exposure"
      ],
      "properties": {
        "audience": { "const": "identified_users" },
        "entry_authentication": { "const": "required" },
        "direct_url_publication": { "const": "prohibited" },
        "origin_protection": { "const": "required_before_network_exposure" },
        "current_exposure": {
          "enum": ["loopback_only", "authenticated_reverse_proxy", "private_network_with_access_control"]
        }
      }
    },
    "commercial_use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "subscriptions", "advertising", "commercial_products", "economic_advantage"],
      "properties": {
        "allowed": { "const": false },
        "subscriptions": { "const": false },
        "advertising": { "const": false },
        "commercial_products": { "const": false },
        "economic_advantage": { "const": false }
      }
    },
    "data_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "service_terms",
          "data_license",
          "attribution_required",
          "modification_notice_required",
          "terms_url"
        ],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "service_terms": { "type": "string", "minLength": 1 },
          "data_license": { "type": "string", "minLength": 1 },
          "attribution_required": { "type": "boolean" },
          "modification_notice_required": { "type": "boolean" },
          "terms_url": { "type": "string", "format": "uri" },
          "license_url": { "type": "string", "format": "uri" },
          "usage_limits": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "output_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shareable_when_reviewed", "restricted", "private", "required_metadata"],
      "properties": {
        "shareable_when_reviewed": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "restricted": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "private": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "required_metadata": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "software_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "paid_contract_allowed", "copyleft_preserved", "corresponding_source_required_when_distributed"],
      "properties": {
        "license": { "const": "GPL-3.0-or-later" },
        "paid_contract_allowed": { "const": true },
        "copyleft_preserved": { "const": true },
        "corresponding_source_required_when_distributed": { "const": true }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_operator", "requires_provenance", "requires_terms_review", "review_triggers"],
      "properties": {
        "requires_operator": { "const": true },
        "requires_provenance": { "const": true },
        "requires_terms_review": { "const": true },
        "review_triggers": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
