{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.local/contracts/participation/1.0.0/boundary-object-envelope.schema.json",
  "title": "BoundaryObjectEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "envelope_id", "object_type", "correlation_id", "participation_id", "contract_version", "authority_reference", "integrity", "context", "provenance", "payload"],
  "properties": {
    "schema": {"const": "sister.boundary-object-envelope/1.0.0"},
    "envelope_id": {"type": "string", "pattern": "^env-[a-z0-9-]+$"},
    "object_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+/1\\.0\\.0$"},
    "correlation_id": {"type": "string", "minLength": 1},
    "participation_id": {"type": "string", "pattern": "^part-[a-z0-9-]+$"},
    "contract_version": {"const": "1.0.0"},
    "authority_reference": {"type": "string", "minLength": 1},
    "integrity": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "context": {"type": "object"},
    "provenance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence-[a-z0-9-]+$"}},
    "payload": {}
  }
}
