{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sister.local/schemas/engineering/planning/1.0.0/development-action.schema.json",
  "title": "SisTer DevelopmentAction",
  "type": "object",
  "required": ["schema", "action_id", "goal_id", "gap_id", "title", "state", "acceptance_criteria", "evidence_requirements"],
  "properties": {
    "schema": {"const": "sister.development-action/1.0.0"},
    "action_id": {"type": "string", "pattern": "^PDE-[A-Z0-9-]+$"},
    "goal_id": {"type": "string", "pattern": "^GOAL-[A-Z0-9-]+$"},
    "gap_id": {"type": "string", "pattern": "^GAP-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "state": {"enum": ["IDEA", "ASSESSED", "PRIORITIZED", "IN_PROGRESS", "VERIFYING", "COMPLETED", "BLOCKED", "SUSPENDED", "SUPERSEDED", "REJECTED"]},
    "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "evidence_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
  },
  "additionalProperties": false
}
