{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sister.local/schemas/engineering/planning/1.0.0/development-gap.schema.json",
  "title": "SisTer DevelopmentGap",
  "type": "object",
  "required": ["schema", "gap_id", "goal_id", "description", "observed_reference", "expected_reference", "status"],
  "properties": {
    "schema": {"const": "sister.development-gap/1.0.0"},
    "gap_id": {"type": "string", "pattern": "^GAP-[A-Z0-9-]+$"},
    "goal_id": {"type": "string", "pattern": "^GOAL-[A-Z0-9-]+$"},
    "description": {"type": "string", "minLength": 1},
    "observed_reference": {"type": "string", "minLength": 1},
    "expected_reference": {"type": "string", "minLength": 1},
    "status": {"enum": ["open", "reduced", "accepted", "superseded"]}
  },
  "additionalProperties": false
}
