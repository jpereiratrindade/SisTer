{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sister.local/schemas/engineering/release/1.0.0/release-manifest.schema.json",
  "title": "SisTer Release Manifest",
  "type": "object",
  "required": ["schema", "engineering_release", "product", "normative_documents", "gates", "publication"],
  "properties": {
    "schema": {"const": "sister.release-manifest/1.0.0"},
    "engineering_release": {
      "type": "object", "required": ["version", "tag", "commit"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }, "additionalProperties": false
    },
    "product": {"type": "object", "required": ["release"], "properties": {"release": {"type": "string", "minLength": 1}, "maturity_state": {"type": "string"}}, "additionalProperties": false},
    "normative_documents": {"type": "object", "required": ["efe", "raf", "pde"], "properties": {"efe": {"type": "string"}, "raf": {"type": "string"}, "pde": {"type": "string"}}, "additionalProperties": false},
    "gates": {"type": "object", "required": ["technical_status", "publication_decision"], "properties": {"technical_status": {"type": "string"}, "publication_decision": {"type": "string"}}, "additionalProperties": false},
    "publication": {"type": "object", "required": ["published", "immutable"], "properties": {"published": {"type": "boolean"}, "immutable": {"const": true}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
