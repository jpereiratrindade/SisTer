{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sister.local/schemas/engineering/maturity-profile/1.0.0/manifest.schema.json",
  "title": "SisTer Maturity Profile Schema",
  "type": "object",
  "required": [
    "schema",
    "id",
    "model",
    "component"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "sister.engineering.maturity-profile/1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "component": {
      "type": "string"
    },
    "model": {
      "type": "string",
      "description": "ID of the maturity model this profile implements."
    },
    "check_suites": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Paths to YAML files containing lists of maturity-check instances."
      }
    }
  }
}
