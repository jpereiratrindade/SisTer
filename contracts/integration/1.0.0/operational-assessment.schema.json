{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.dev/contracts/integration/1.0.0/operational-assessment.schema.json",
  "type": "object",
  "required": ["assessment_id", "integration_id", "execution_id", "expected", "observed", "result", "recommendation", "assessed_at"],
  "additionalProperties": false,
  "properties": {
    "assessment_id": {"type": "string", "minLength": 1},
    "integration_id": {"type": "string", "minLength": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "expected": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "observed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "result": {"enum": ["confirmed", "divergent", "inconclusive"]},
    "severity": {"enum": ["informational", "low", "medium", "high", "critical"], "default": "informational"},
    "recommendation": {
      "type": "object",
      "required": ["action", "summary"],
      "additionalProperties": false,
      "properties": {
        "action": {"enum": ["none", "review_mapping", "review_contract", "collect_evidence", "request_human_decision"]},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "human_decision_required": {"type": "boolean", "default": false},
    "assessed_at": {"type": "string", "format": "date-time"}
  }
}
