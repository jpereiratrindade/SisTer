{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.dev/contracts/integration/1.0.0/integration-decision.schema.json",
  "type": "object",
  "required": ["decision_id", "integration_id", "integration_version", "decision", "decided_by", "authority", "rationale", "decided_at"],
  "additionalProperties": false,
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "integration_id": {"type": "string", "minLength": 1},
    "integration_version": {"type": "string", "minLength": 1},
    "decision": {"enum": ["approved", "rejected"]},
    "decided_by": {"type": "string", "minLength": 1},
    "authority": {"const": "integration.approve"},
    "rationale": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "effects": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
