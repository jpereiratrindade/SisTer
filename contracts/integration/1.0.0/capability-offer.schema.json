{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.dev/contracts/integration/1.0.0/capability-offer.schema.json",
  "type": "object",
  "required": ["offer_id", "subsystem_id", "capability", "produces", "contract", "published_at"],
  "additionalProperties": false,
  "properties": {
    "offer_id": {"type": "string", "minLength": 1},
    "subsystem_id": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "produces": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "contract": {"$ref": "#/$defs/schema-reference"},
    "status": {"enum": ["proposed", "active", "deprecated", "suspended"], "default": "active"},
    "published_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "schema-reference": {
      "type": "object",
      "required": ["schema_id", "version"],
      "additionalProperties": false,
      "properties": {
        "schema_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1}
      }
    }
  }
}
