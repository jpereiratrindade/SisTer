{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.dev/contracts/integration/1.0.0/integration-execution.schema.json",
  "type": "object",
  "required": ["execution_id", "integration_id", "integration_version", "status", "started_at", "inputs", "transformations_applied"],
  "additionalProperties": false,
  "properties": {
    "execution_id": {"type": "string", "minLength": 1},
    "integration_id": {"type": "string", "minLength": 1},
    "integration_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["running", "completed", "failed", "cancelled"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/data-reference"}},
    "transformations_applied": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/data-reference"}},
    "observations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "errors": {"type": "array", "items": {"type": "object", "required": ["code", "message"], "additionalProperties": false, "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}
  },
  "$defs": {
    "data-reference": {
      "type": "object",
      "required": ["reference_id", "schema_id", "digest"],
      "additionalProperties": false,
      "properties": {
        "reference_id": {"type": "string", "minLength": 1},
        "schema_id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[A-Za-z0-9._:-]+$"},
        "subsystem_id": {"type": "string"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "completed"}}}, "then": {"required": ["finished_at", "outputs"]}},
    {"if": {"properties": {"status": {"const": "failed"}}}, "then": {"required": ["finished_at", "errors"]}}
  ]
}
