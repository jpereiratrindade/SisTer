{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.dev/contracts/integration/1.0.0/integration-definition.schema.json",
  "type": "object",
  "required": ["integration_id", "version", "objective", "offer_id", "requirement_id", "source_subsystem_id", "target_subsystem_id", "field_mappings", "success_criteria", "approval"],
  "additionalProperties": false,
  "properties": {
    "integration_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "offer_id": {"type": "string", "minLength": 1},
    "requirement_id": {"type": "string", "minLength": 1},
    "source_subsystem_id": {"type": "string", "minLength": 1},
    "target_subsystem_id": {"type": "string", "minLength": 1},
    "field_mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field-mapping"}},
    "transformations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "approval": {
      "type": "object",
      "required": ["status", "responsible", "authority"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["draft", "approved", "rejected", "superseded"]},
        "responsible": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "field-mapping": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "transform": {"type": "string"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"approval": {"properties": {"status": {"const": "approved"}}}}}, "then": {"properties": {"approval": {"required": ["approved_at"]}}}}
  ]
}
