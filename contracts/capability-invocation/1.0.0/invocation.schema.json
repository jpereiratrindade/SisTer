{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.local/contracts/capability-invocation/1.0.0/invocation.schema.json",
  "title": "SisTer Capability Invocation Draft",
  "description": "DRAFT / NOT RUNTIME-NORMATIVE semantic capability request.",
  "x-sister-contract-status": "DRAFT",
  "x-sister-runtime-normative": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_status",
    "runtime_normative",
    "invocation_id",
    "request_id",
    "caller_participant_id",
    "target_participant_id",
    "capability",
    "purpose",
    "contract_ref",
    "arguments",
    "deadline_at"
  ],
  "properties": {
    "schema": {"const": "sister.capability-invocation/1.0.0"},
    "contract_status": {"const": "DRAFT"},
    "runtime_normative": {"const": false},
    "invocation_id": {"type": "string", "pattern": "^inv-[a-z0-9-]{8,96}$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "caller_participant_id": {"$ref": "#/$defs/participant-id"},
    "target_participant_id": {"$ref": "#/$defs/participant-id"},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "version"],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){2,5}$"
        },
        "version": {"$ref": "#/$defs/semantic-version"}
      }
    },
    "relation_id": {"type": "string", "pattern": "^rel-[a-z0-9-]{3,96}$"},
    "subject_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "subject_id", "audience", "issued_at", "expires_at", "integrity_ref"],
      "properties": {
        "issuer": {"type": "string", "minLength": 3, "maxLength": 160},
        "subject_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "audience": {"$ref": "#/$defs/participant-id"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "integrity_ref": {"type": "string", "minLength": 3, "maxLength": 500},
        "claims": {"type": "object"}
      }
    },
    "purpose": {"type": "string", "minLength": 8, "maxLength": 500},
    "contract_ref": {"$ref": "#/$defs/contract-reference"},
    "arguments": {"type": "object"},
    "deadline_at": {"type": "string", "format": "date-time"},
    "evidence_context": {
      "type": "array",
      "items": {"type": "string", "minLength": 3, "maxLength": 500},
      "uniqueItems": true
    }
  },
  "$defs": {
    "participant-id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "semantic-version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "contract-reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "version"],
      "properties": {
        "schema_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
        "version": {"$ref": "#/$defs/semantic-version"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
