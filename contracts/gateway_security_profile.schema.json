{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.local/contracts/gateway-security-profile/1.0.0",
  "title": "SisTer gateway security profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "status",
    "technology",
    "realizability",
    "deployment",
    "network",
    "tls",
    "http",
    "headers",
    "rate_limits",
    "observability",
    "rollback",
    "gates",
    "threats"
  ],
  "properties": {
    "contract_id": {"const": "sister.gateway-security-profile"},
    "contract_version": {"const": "1.0.0"},
    "status": {"const": "PROFILE_DEFINED"},
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "edition", "approved_branch", "initial_validated_floor", "patch_policy", "version_verified_on", "official_release_index", "lts_eol", "plugins"],
      "properties": {
        "product": {"const": "haproxy"},
        "edition": {"const": "community"},
        "approved_branch": {"const": "3.2"},
        "initial_validated_floor": {"type": "string", "pattern": "^3\\.2\\.[0-9]+$"},
        "patch_policy": {"const": "latest_maintained_patch_at_or_above_floor"},
        "version_verified_on": {"type": "string", "format": "date"},
        "official_release_index": {"const": "https://www.haproxy.org/"},
        "lts_eol": {"const": "2030-Q2"},
        "plugins": {"type": "array", "maxItems": 0}
      }
    },
    "realizability": {"$ref": "#/$defs/object"},
    "deployment": {"$ref": "#/$defs/object"},
    "network": {"$ref": "#/$defs/object"},
    "tls": {"$ref": "#/$defs/object"},
    "http": {"$ref": "#/$defs/object"},
    "headers": {"$ref": "#/$defs/object"},
    "rate_limits": {"$ref": "#/$defs/object"},
    "observability": {"$ref": "#/$defs/object"},
    "rollback": {"$ref": "#/$defs/object"},
    "gates": {"$ref": "#/$defs/object"},
    "threats": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "control", "test", "evidence", "residual_risk", "owner", "state"],
        "properties": {
          "id": {"type": "string", "pattern": "^TH-[A-Z]+-[0-9]{2}$"},
          "control": {"type": "string", "minLength": 1},
          "test": {"type": "string", "minLength": 1},
          "evidence": {"const": "SEC-03V_PENDING"},
          "residual_risk": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "state": {"const": "PROFILE_DEFINED"}
        }
      }
    }
  },
  "$defs": {
    "object": {
      "type": "object",
      "minProperties": 1
    }
  }
}
