{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.local/contracts/gateway-security-profile/1.2.0",
  "title": "SisTer gateway security profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "status",
    "technology",
    "realizability",
    "deployment",
    "network",
    "tls",
    "http",
    "headers",
    "rate_limits",
    "resource_limits",
    "observability",
    "rollback",
    "gates",
    "threats"
  ],
  "properties": {
    "contract_id": {"const": "sister.gateway-security-profile"},
    "contract_version": {"const": "1.2.0"},
    "status": {"const": "PROFILE_DEFINED"},
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "edition", "approved_branch", "initial_validated_floor", "patch_policy", "version_verified_on", "official_release_index", "lts_eol", "plugins"],
      "properties": {
        "product": {"const": "haproxy"},
        "edition": {"const": "community"},
        "approved_branch": {"const": "3.2"},
        "initial_validated_floor": {"type": "string", "pattern": "^3\\.2\\.[0-9]+$"},
        "patch_policy": {"const": "latest_maintained_patch_at_or_above_floor"},
        "version_verified_on": {"type": "string", "format": "date"},
        "official_release_index": {"const": "https://www.haproxy.org/"},
        "lts_eol": {"const": "2030-Q2"},
        "plugins": {"type": "array", "maxItems": 0}
      }
    },
    "realizability": {"$ref": "#/$defs/realizability"},
    "deployment": {"$ref": "#/$defs/object"},
    "network": {"$ref": "#/$defs/object"},
    "tls": {"$ref": "#/$defs/object"},
    "http": {"$ref": "#/$defs/object"},
    "headers": {"$ref": "#/$defs/object"},
    "rate_limits": {"$ref": "#/$defs/object"},
    "resource_limits": {"$ref": "#/$defs/object"},
    "observability": {"$ref": "#/$defs/object"},
    "rollback": {"$ref": "#/$defs/object"},
    "gates": {"$ref": "#/$defs/object"},
    "threats": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "control", "test", "evidence", "residual_risk", "owner", "state"],
        "properties": {
          "id": {"type": "string", "pattern": "^TH-[A-Z]+-[0-9]{2}$"},
          "control": {"type": "string", "minLength": 1},
          "test": {"type": "string", "minLength": 1},
          "evidence": {"const": "SEC-03V_PENDING"},
          "residual_risk": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "state": {"const": "PROFILE_DEFINED"}
        }
      }
    }
  },
  "$defs": {
    "outcome_state": {
      "enum": [
        "NATIVE_DOCUMENTED",
        "PROVEN",
        "PROVEN_BY_SAFE_NORMALIZATION",
        "PROVEN_BY_REJECTION",
        "PROVEN_BY_STRIPPING",
        "ACCEPTED_LAB_DIVERGENCE",
        "DEFERRED_TO_SEC-03V",
        "SEC-03C_PENDING",
        "PARTIALLY_PROVEN",
        "MECHANISM_UNPROVEN",
        "NOT_IMPLEMENTED"
      ]
    },
    "realizability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_gate", "policy", "lua_allowed", "third_party_modules_allowed", "requirements", "laboratory_resolution", "sec_03c_resolution"],
      "properties": {
        "verification_gate": {"const": "SEC-03C"},
        "policy": {"const": "native_simple_or_record_residual_risk"},
        "lua_allowed": {"const": false},
        "third_party_modules_allowed": {"const": false},
        "requirements": {
          "type": "array",
          "minItems": 18,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "mechanism", "state"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
              "mechanism": {"type": "string", "minLength": 1},
              "state": {"$ref": "#/$defs/outcome_state"}
            }
          }
        },
        "laboratory_resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision_id", "state", "decided_on", "evidence", "authorizes_next_gate", "merge_authorized", "release_authorized", "external_exposure_authorized", "host_exception"],
          "properties": {
            "decision_id": {"const": "SEC-03B-R"},
            "state": {"const": "LAB_PROVEN_WITH_RESTRICTIONS"},
            "decided_on": {"type": "string", "format": "date"},
            "evidence": {"const": "docs/evidence/security/SEC-03B.md"},
            "authorizes_next_gate": {"const": "SEC-03C"},
            "merge_authorized": {"const": false},
            "release_authorized": {"const": false},
            "external_exposure_authorized": {"const": false},
            "host_exception": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "owner", "justification", "scope", "residual_risk", "review_gate", "reopen_conditions"],
              "properties": {
                "state": {"const": "ACCEPTED_LAB_DIVERGENCE"},
                "owner": {"type": "string", "minLength": 1},
                "justification": {"type": "string", "minLength": 1},
                "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "residual_risk": {"type": "string", "minLength": 1},
                "review_gate": {"const": "SEC-03V"},
                "reopen_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        },
        "sec_03c_resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "decided_on", "evidence", "next_gate", "merge_authorized", "release_authorized", "external_exposure_authorized"],
          "properties": {
            "state": {"const": "LAB_PROVEN_WITH_RESTRICTIONS"},
            "decided_on": {"type": "string", "format": "date"},
            "evidence": {"const": "docs/evidence/security/SEC-03C.md"},
            "next_gate": {"const": "ISO-01"},
            "merge_authorized": {"const": false},
            "release_authorized": {"const": false},
            "external_exposure_authorized": {"const": false}
          }
        }
      }
    },
    "object": {
      "type": "object",
      "minProperties": 1
    }
  }
}
