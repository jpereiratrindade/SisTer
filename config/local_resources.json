        {"kind": "postgresql", "environment": "dev", "host": "127.0.0.1", "port": 55436, "container": "labgp-web-postgres"}
      ]
    },
    {
      "id": "governanca",
      "repository": null,
      "integrates_with_sister": false,
      "status": "migration-required",
      "resources": [
        {"kind": "postgresql", "environment": "dev", "host": "127.0.0.1", "port": 55437, "container": "governanca_db", "volume": "governanca_pgdata"}
      ]
