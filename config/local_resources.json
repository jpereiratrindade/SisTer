{
  "version": "1.0.0",
  "scope": "local-development",
  "projects": [
    {
      "id": "sister",
      "repository": "cpp/SisTer",
      "integrates_with_sister": true,
      "resources": [
        {"kind": "http", "environment": "dev", "host": "127.0.0.1", "port": 8000},
        {"kind": "http", "environment": "test", "host": "127.0.0.1", "port": 8001},
        {"kind": "postgresql", "environment": "dev", "host": "127.0.0.1", "port": 55434, "container": "sister-dev-db", "volume": "sister_dev_pgdata"},
        {"kind": "postgresql", "environment": "test", "host": "127.0.0.1", "port": 55435, "container": "sister-test-db", "volume": "sister_test_pgdata"}
      ]
    },
    {
      "id": "sister_reference",
      "repository": "cpp/SisTer/reference/sister-reference",
      "integrates_with_sister": true,
      "integration_state": "reference",
      "operational_access": true,
      "orchestration": {
        "policy": "ensure-running",
        "environment": "dev",
        "required": true,
        "health": {
          "url": "http://127.0.0.1:19001/api/health",
          "expected_json": {"status": "ok", "system_id": "sister_reference"}
        },
        "start": {
          "argv": ["./scripts/run.sh"],
          "ready_timeout_seconds": 15
        }
      },
      "resources": [
        {"kind": "http", "environment": "dev", "host": "127.0.0.1", "port": 19001, "exposure": "internal"}
      ]
    },
    {
      "id": "sister_campo",
      "repository": "cpp/SisTer-Campo",
      "integrates_with_sister": true,
      "resources": [
        {"kind": "http", "environment": "dev", "host": "127.0.0.1", "port": 8013},
        {"kind": "postgresql", "environment": "dev", "host": "127.0.0.1", "port": 55438, "container": "sister-campo-dev-db", "volume": "sister_campo_dev_pgdata"}
      ]
    },
    {
      "id": "sister_nexo",
      "repository": "cpp/sister-nexo",
      "integrates_with_sister": true,
      "integration_state": "quarantined",
      "operational_access": false,
      "quarantine_reason": "core_reference_validation_in_progress",
      "orchestration": {
        "policy": "quarantined",
        "environment": "dev",
        "required": false,
        "health": {
          "url": "http://127.0.0.1:8015/api/health",
          "expected_json": {
            "status": "ok",
            "service": "sister-nexo",
            "database": "ok"
          }
        },
        "start": {
          "argv": ["./scripts/run.sh"],
          "ready_timeout_seconds": 180
        },
        "refresh": {
          "policy": "on-source-change",
          "paths": [
            "CMakeLists.txt",
            "compose.yml",
            "docker",
            "include",
            "scripts/import_legacy_django.sh",
            "scripts/import_legacy_ledgers.py",
            "scripts/migrate.sh",
            "scripts/run.sh",
            "scripts/smoke.sh",
            "scripts/stop.sh",
            "src",
            "storage/migrations",
            "vendor",
            "web"
          ]
        }
      },
      "resources": [
        {"kind": "http", "environment": "dev", "host": "127.0.0.1", "port": 8015, "exposure": "internal"},
        {"kind": "postgresql", "environment": "dev", "host": "127.0.0.1", "port": 55439, "container": "sister-nexo-dev-db", "volume": "sister_nexo_dev_pgdata"}
      ]
    },
    {
      "id": "morfocampo",
      "repository": "cpp/morfocampo",
      "integrates_with_sister": false,
      "status": "temporarily-unregistered",
      "resources": [
        {"kind": "https", "environment": "dev", "host": "0.0.0.0", "port": 8011}
      ]
    },
    {
      "id": "droneops",
      "repository": "cpp/droneops",
      "integrates_with_sister": false,
      "status": "temporarily-unregistered",
      "resources": [
        {"kind": "https", "environment": "dev", "host": "0.0.0.0", "port": 8012}
      ]
    },
    {
      "id": "camponode",
      "repository": null,
      "integrates_with_sister": false,
      "status": "planned",
      "resources": []
    },
    {
      "id": "radar_sister_resiliencia",
      "repository": "cpp/radar_sister_resiliencia",
      "integrates_with_sister": false,
      "status": "temporarily-unregistered",
      "resources": [
        {"kind": "http", "environment": "dev", "host": "127.0.0.1", "port": 8765},
        {"kind": "postgresql", "environment": "dev", "host": "127.0.0.1", "port": 55432, "container": "radar-sister-pgvector-pg17", "volume": "radar_sister_pgvector_pg17_data"}
      ]
    },
    {
      "id": "sister_clima",
      "repository": "python/Sister-Clima",
      "integrates_with_sister": true,
      "integration_state": "quarantined",
      "operational_access": false,
      "quarantine_reason": "core_reference_validation_in_progress",
      "orchestration": {
        "policy": "quarantined",
        "environment": "dev",
        "required": false,
        "health": {
          "url": "http://127.0.0.1:8501/_stcore/health",
          "expected_text": "ok"
        },
        "start": {
          "argv": ["./venv/bin/streamlit", "run", "app.py"],
          "ready_timeout_seconds": 90,
          "environment": {
            "STREAMLIT_SERVER_ADDRESS": "127.0.0.1",
            "STREAMLIT_SERVER_PORT": "8501"
          }
        }
      },
      "resources": [
        {"kind": "http", "environment": "dev", "host": "127.0.0.1", "port": 8501, "exposure": "internal"}
      ]
    },
    {
      "id": "sister_studio",
      "repository": "Sister-Studio",
      "integrates_with_sister": true,
      "integration_state": "quarantined",
      "operational_access": false,
      "quarantine_reason": "core_reference_validation_in_progress",
      "components": ["audio", "voice", "video"],
      "orchestration": {
        "policy": "quarantined",
        "environment": "dev",
        "required": false,
        "health": {
          "url": "https://127.0.0.1:18443/api/health",
          "tls_verify": false,
          "expected_json": {"status": "ok", "service": "sister-studio"}
        },
        "start": {
          "argv": ["./scripts/run_all.sh"],
          "ready_timeout_seconds": 240,
          "environment": {
            "SISTER_STUDIO_BIND_HOST": "127.0.0.1",
            "SISTER_STUDIO_PORT": "18443"
          }
        }
      },
      "resources": [
        {"kind": "https", "environment": "dev", "host": "127.0.0.1", "port": 18443, "container": "sister-studio-dev", "volume": "sister_studio_generated", "exposure": "internal"},
        {"kind": "http", "environment": "dev", "host": "127.0.0.1", "port": 8088, "exposure": "internal"},
        {"kind": "http", "environment": "dev", "host": "127.0.0.1", "port": 18013, "exposure": "internal"},
        {"kind": "http", "environment": "dev", "host": "127.0.0.1", "port": 18043, "exposure": "internal"},
        {"kind": "http", "environment": "dev", "host": "127.0.0.1", "port": 18014, "exposure": "internal"},
        {"kind": "postgresql", "environment": "dev", "host": "127.0.0.1", "port": 55433, "container": "pocket_tts_postgres", "volume": "pocket_tts_postgres_data"}
      ]
    },
    {
      "id": "sister_confia",
      "repository": "cpp/sister_confia",
      "integrates_with_sister": false,
      "status": "candidate",
      "resources": []
    },
    {
      "id": "sister_compras",
      "repository": "cpp/sister_compras",
      "integrates_with_sister": false,
      "integrates_with": "sister_nexo",
      "integration_contract": "nexo-compras.integration/1.0.0",
      "product_name": "Nexo-Compras",
      "status": "integrated-with-nexo",
      "integration_state": "quarantined",
      "operational_access": false,
      "quarantine_reason": "core_reference_validation_in_progress",
      "orchestration": {
        "policy": "quarantined",
        "environment": "dev",
        "required": false,
        "health": {
          "url": "http://127.0.0.1:8016/api/health",
          "expected_json": {
            "status": "ok",
            "service": "nexo-compras",
            "database": "ok"
          }
        },
        "start": {
          "argv": ["./scripts/run_all.sh", "dev", "8016"],
          "ready_timeout_seconds": 180
        },
        "refresh": {
          "policy": "on-source-change",
          "paths": [
            "CMakeLists.txt",
            "compose.yml",
            "contracts",
            "db",
            "include",
            "scripts",
            "src",
            "tests",
            "web"
          ]
        }
      },
      "resources": [
        {"kind": "http", "environment": "dev", "host": "127.0.0.1", "port": 8016, "exposure": "internal"},
        {"kind": "postgresql", "environment": "dev", "host": "127.0.0.1", "port": 55440, "container": "nexo-compras-dev-db", "volume": "nexo_compras_dev_pgdata"}
      ]
    },
    {
      "id": "sister_video",
      "repository": "python/Sister-Video",
      "integrates_with_sister": false,
      "status": "superseded-by-sister-studio",
      "resources": []
