{
  "version": "1.0.0",
  "scope": "local-development",
  "principle": "SisTer conhece apenas seu nucleo e o subsistema de referencia controlado. Subsistemas reais entram somente por contratos assinados na Base Operacional.",
  "projects": [
    {
      "id": "sister",
      "repository": "cpp/SisTer",
      "integrates_with_sister": true,
      "resources": [
        {"kind": "http", "environment": "dev", "host": "127.0.0.1", "port": 8000},
        {"kind": "http", "environment": "test", "host": "127.0.0.1", "port": 8001},
        {"kind": "postgresql", "environment": "dev", "host": "127.0.0.1", "port": 55434, "container": "sister-dev-db", "volume": "sister_dev_pgdata"},
        {"kind": "postgresql", "environment": "test", "host": "127.0.0.1", "port": 55435, "container": "sister-test-db", "volume": "sister_test_pgdata"}
      ]
    },
    {
      "id": "sister_reference",
      "repository": "cpp/SisTer/reference/sister-reference",
      "integrates_with_sister": true,
      "integration_state": "reference",
      "operational_access": true,
      "orchestration": {
        "policy": "ensure-running",
        "environment": "dev",
        "required": true,
        "health": {
          "url": "http://127.0.0.1:19001/api/health",
          "expected_json": {"status": "ok", "system_id": "sister_reference"}
        },
        "start": {
          "argv": ["./scripts/run.sh"],
          "ready_timeout_seconds": 15
        }
      },
      "resources": [
        {"kind": "http", "environment": "dev", "host": "127.0.0.1", "port": 19001, "exposure": "internal"}
      ]
    }
  ]
}
