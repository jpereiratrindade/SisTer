#!/usr/bin/env python3
import argparse
from datetime import datetime, timezone
import json
import os
import subprocess
import sys
from pathlib import Path

import yaml


ROOT = Path(__file__).resolve().parents[1]
PLAN_PATH = ROOT / "engineering/planning/plan.json"


def plan_path():
    return Path(os.environ.get("SISTER_PLAN_PATH", PLAN_PATH))


def run(command, env=None):
    return subprocess.call(command, cwd=ROOT, env=env)


def resolved_engine(component, requested_engine):
    return requested_engine or ("compare" if component == "sister-core" else "declarative")


def run_internal_publisher(command):
    environment = os.environ.copy()
    environment["SGE_INTERNAL_PUBLISH"] = "1"
    return run(command, env=environment)


def cmd_maturity_evaluate(args):
    command = [
        sys.executable,
        str(ROOT / "scripts/maturity/evaluate-engine.py"),
        "--repo",
        str(ROOT),
        "--component-root",
        args.component_root,
        "--component",
        args.component,
        "--stage",
        args.stage,
        "--status-json",
        "-",
    ]
    if args.engine:
        command.extend(["--engine", args.engine])
    if args.profile:
        command.extend(["--profile", args.profile])
    if args.strict:
        command.append("--strict")
    with subprocess.Popen(command, cwd=ROOT) as proc:
        return proc.wait()


def cmd_maturity_publish(args):
    command = [str(ROOT / "scripts/maturity/run-and-publish.sh")]
    if args.stage:
        command.append(args.stage)
    if args.component:
        command.extend(["--component", args.component])
    if args.component_root:
        command.extend(["--component-root", args.component_root])
    command.extend(["--engine", resolved_engine(args.component, args.engine)])
    return run_internal_publisher(command)

def infer_component_root(component_id, profile):
    if component_id == "sister-core":
        return ROOT
    root_config = profile.get("component_root", {}) if isinstance(profile, dict) else {}
    path_env = root_config.get("path_env")
    if path_env and os.environ.get(path_env):
        return Path(os.environ[path_env]).expanduser().resolve()
    return None


def cmd_maturity_publish_all(args):
    ecosystem_path = ROOT / "engineering/maturity/ecosystem.yaml"
    ecosystem = yaml.safe_load(ecosystem_path.read_text(encoding="utf-8")) or {"components": []}
    failures = 0
    skipped = 0
    quarantined = 0
    for component in ecosystem.get("components", []):
        component_id = component["id"]
        if component.get("governance_status") == "quarantined":
            print(f"QUARANTINED {component_id}: avaliação operacional não autorizada")
            quarantined += 1
            continue
        profile_path = ROOT / "engineering/maturity/profiles" / f"{component_id}.yaml"
        if not profile_path.exists():
            print(f"SKIP {component_id}: perfil ausente")
            skipped += 1
            continue
        profile = yaml.safe_load(profile_path.read_text(encoding="utf-8")) or {}
        component_root = infer_component_root(component_id, profile)
        if component_root is None or not component_root.exists():
            root_config = profile.get("component_root", {}) if isinstance(profile, dict) else {}
            path_env = root_config.get("path_env", "COMPONENT_REPO")
            print(f"SKIP {component_id}: raiz não resolvida; defina {path_env}")
            skipped += 1
            continue
        command = [
            str(ROOT / "scripts/maturity/run-and-publish.sh"),
        ]
        if args.stage:
            command.append(args.stage)
        command.extend(["--component", component_id, "--component-root", str(component_root)])
        command.extend(["--engine", resolved_engine(component_id, args.engine)])
        stage_label = args.stage or "inferido"
        engine_label = resolved_engine(component_id, args.engine)
        print(f"RUN {component_id}: gate={stage_label} engine={engine_label}", flush=True)
        rc = run_internal_publisher(command)
        if rc != 0:
            failures += 1
            print(f"FAIL {component_id}: rc={rc}")
    cmd_maturity_components(args)
    print(
        f"publish-all concluído: failures={failures} skipped={skipped} "
        f"quarantined={quarantined}"
    )
    return 1 if failures else 0


def cmd_maturity_components(_args):
    rc = run([sys.executable, str(ROOT / "scripts/maturity/aggregate-components.py")])
    if rc != 0:
        return rc
    return run([sys.executable, str(ROOT / "scripts/maturity/build-catalog.py")])


def cmd_maturity_validate(args):
    if args.status_json:
        return run([sys.executable, str(ROOT / "scripts/maturity/validate-status.py"), args.status_json])
    return run([sys.executable, str(ROOT / "scripts/maturity/validate-contracts.py"), "--repo", str(ROOT)])


def cmd_verify(args):
    quality_rc = run([str(ROOT / "scripts/run_quality.sh")])
    maturity_rc = cmd_maturity_publish_all(argparse.Namespace(stage=args.stage, engine=None))
    print(
        f"verificação completa: qualidade={'PASS' if quality_rc == 0 else 'FAIL'} "
        f"maturidade={'PASS' if maturity_rc == 0 else 'FAIL'}"
    )
    return quality_rc or maturity_rc


def load_plan():
    try:
        return json.loads(plan_path().read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        print(f"erro: plano inválido: {exc}", file=sys.stderr)
        return None


def emit_plan(value, as_json):
    if as_json:
        print(json.dumps(value, ensure_ascii=False, indent=2))
        return
    if isinstance(value, list):
        for item in value:
            print(f"{item.get('action_id', item.get('gap_id', item.get('goal_id', '?')))}\t{item.get('state', item.get('status', ''))}\t{item.get('title', item.get('description', ''))}")
    else:
        if "plan_id" in value:
            print(f"Plano: {value['plan_id']}  revisão: {value['revision']}")
            print(f"Objetivo: {value['goal']['goal_id']} — {value['goal']['title']}")
            for action in value.get("actions", []):
                print(f"Ação: {action['action_id']} [{action['state']}] — {action['title']}")
        else:
            identifier = value.get("decision_id", value.get("assessment_id", "record"))
            print(f"{identifier} registrado")


def explain_action(plan, action):
    gap = next((g for g in plan.get("gaps", []) if g["gap_id"] == action["gap_id"]), None)
    goal = next((g for g in [plan.get("goal")] if g and g["goal_id"] == action["goal_id"]), None)
    assessments = [a for a in plan.get("assessments", []) if a.get("action_id") == action["action_id"]]
    decisions = [d for d in plan.get("decisions", []) if d.get("action_id") == action["action_id"]]
    revisions = [r for r in plan.get("revisions", []) if r.get("revision_id") == plan.get("revision") or r.get("revision_id") == "PLAN-REV-INITIAL"]
    return {
        "plan_id": plan["plan_id"], "revision": plan["revision"],
        "goal": goal, "gap": gap, "action": action,
        "assessments": assessments, "decisions": decisions,
        "revisions": revisions, "current_state": action["state"]
    }


def parse_timestamp(value):
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


def cmd_plan(args):
    plan = load_plan()
    if plan is None:
        return 2
    if args.command == "assess":
        action = next((a for a in plan.get("actions", []) if a["action_id"] == args.action_id), None)
        if action is None:
            print(f"ação não encontrada: {args.action_id}", file=sys.stderr)
            return 1
        value = {
            "schema": "sister.priority-assessment/1.0.0",
            "assessment_id": f"PLAN-ASSESS-{action['action_id'].replace('PDE-', '')}",
            "action_id": action["action_id"],
            "evaluator": "sge-planning/1.0.0",
            "recommendation": "P0" if action["action_id"] == "PDE-MVP01-01" else "DEFER",
            "evidence": ["docs/planning/PDE-SISTER.md", "docs/reports/RAF-SisTer/relatorio_atualizacao_funcional_sister_v1_0.tex"],
            "assessed_at": "2026-08-03T00:00:00Z"
        }
        if args.persist:
            plan.setdefault("assessments", []).append(value)
            plan_path().write_text(json.dumps(plan, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        emit_plan(value, args.json)
        return 0
    if args.command == "decision":
        if args.decision_command != "record":
            print("operação de decisão não suportada", file=sys.stderr)
            return 2
        try:
            decision = json.loads(Path(args.path).read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            print(f"decisão inválida: {exc}", file=sys.stderr)
            return 2
        required = ("schema", "decision_id", "action_id", "decision", "authorized_transition", "actor", "authority", "reason", "assessment_id", "origin_baseline", "decision_commit", "valid_until", "plan_revision", "decided_at")
        if any(not decision.get(field) for field in required) or decision["decision"] not in {"approve", "reject", "suspend", "supersede"}:
            print("decisão inválida: campos obrigatórios ou decisão inválida", file=sys.stderr)
            return 2
        if not any(a["action_id"] == decision["action_id"] for a in plan.get("actions", [])):
            print("decisão inválida: ação não encontrada", file=sys.stderr)
            return 1
        if any(d.get("decision_id") == decision["decision_id"] for d in plan.get("decisions", [])):
            print("decisão inválida: identificador já registrado", file=sys.stderr)
            return 1
        assessment = next((a for a in plan.get("assessments", []) if a.get("assessment_id") == decision["assessment_id"] and a.get("action_id") == decision["action_id"]), None)
        if assessment is None:
            print("decisão inválida: avaliação da mesma ação não encontrada", file=sys.stderr)
            return 1
        if decision["plan_revision"] != plan.get("revision"):
            print("decisão inválida: linha de base do plano desatualizada", file=sys.stderr)
            return 1
        if plan.get("origin_baseline") and decision["origin_baseline"] != plan["origin_baseline"]:
            print("decisão inválida: baseline incompatível com o plano", file=sys.stderr)
            return 1
        try:
            if parse_timestamp(decision["valid_until"]) <= parse_timestamp(decision["decided_at"]):
                raise ValueError
        except (ValueError, TypeError):
            print("decisão inválida: validade deve ser posterior ao instante da decisão", file=sys.stderr)
            return 2
        decision["used"] = False
        plan.setdefault("decisions", []).append(decision)
        plan_path().write_text(json.dumps(plan, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        emit_plan(decision, args.json)
        return 0
    if args.command == "transition":
        action = next((a for a in plan.get("actions", []) if a["action_id"] == args.action_id), None)
        if action is None:
            print(f"ação não encontrada: {args.action_id}", file=sys.stderr)
            return 1
        requested_transition = f"{action['state']}->{args.state}"
        decision = next((d for d in plan.get("decisions", []) if d.get("decision_id") == args.decision_id and d.get("action_id") == args.action_id and d.get("decision") == "approve" and d.get("authorized_transition") == requested_transition and not d.get("used", False)), None)
        if decision is None:
            print("transição bloqueada: decisão humana aprovada e vigente não encontrada", file=sys.stderr)
            return 1
        if decision.get("plan_revision") != plan.get("revision"):
            print("transição bloqueada: decisão baseada em revisão obsoleta", file=sys.stderr)
            return 1
        try:
            if parse_timestamp(decision["valid_until"]) <= datetime.now(timezone.utc):
                print("transição bloqueada: decisão expirada", file=sys.stderr)
                return 1
        except (KeyError, ValueError, TypeError):
            print("transição bloqueada: validade da decisão inválida", file=sys.stderr)
            return 1
        if decision:
            decision["used"] = True
            revision_id = f"PLAN-REV-{args.action_id.replace('PDE-', '')}-{args.state}"
            plan.setdefault("revisions", []).append({
                "schema": "sister.plan-revision/1.0.0",
                "revision_id": revision_id,
                "previous_revision": plan["revision"],
                "reason": f"Transição autorizada {action['state']}->{args.state}.",
                "actor": decision["actor"],
                "evidence": [decision["decision_id"], decision["assessment_id"]],
                "created_at": decision["decided_at"]
            })
            plan["revision"] = revision_id
        action["state"] = args.state
        plan_path().write_text(json.dumps(plan, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        emit_plan(action, args.json)
        return 0
    if args.command == "status":
        value = plan
    elif args.command == "list":
        value = plan.get("actions", [])
    elif args.command == "gaps":
        value = plan.get("gaps", [])
    elif args.command in {"show", "explain"}:
        value = next((a for a in plan.get("actions", []) if a["action_id"] == args.action_id), None)
        if value is None:
            print(f"ação não encontrada: {args.action_id}", file=sys.stderr)
            return 1
        if args.command == "explain" and args.json:
            emit_plan(explain_action(plan, value), True)
            return 0
        if args.command == "explain" and not args.json:
            gap = next(g for g in plan["gaps"] if g["gap_id"] == value["gap_id"])
            print(f"Ação {value['action_id']}: {value['title']}")
            print(f"Estado: {value['state']}")
            print(f"Objetivo: {value['goal_id']}")
            print(f"Lacuna: {gap['description']}")
            print(f"Observado: {gap['observed_reference']}")
            print(f"Esperado: {gap['expected_reference']}")
            print("Critérios:")
            for criterion in value["acceptance_criteria"]:
                print(f"- {criterion}")
            chain = explain_action(plan, value)
            for assessment in chain["assessments"]:
                print(f"Avaliação {assessment['assessment_id']}: recomendação {assessment['recommendation']}")
            for decision in chain["decisions"]:
                print(f"Decisão {decision['decision_id']}: {decision['authorized_transition']} por {decision['actor']} ({'usada' if decision.get('used') else 'vigente'})")
            for revision in chain["revisions"]:
                print(f"Revisão: {revision['revision_id']} — {revision['reason']}")
            print(f"Estado atual: {value['state']}")
            return 0
    emit_plan(value, args.json)
    return 0


def build_parser():
    parser = argparse.ArgumentParser(prog="scripts/sge", description="SGE-SisTer command line tools.")
    subparsers = parser.add_subparsers(dest="area", required=True)

    verify = subparsers.add_parser(
        "verify",
        help="Run repository quality and publish maturity for all resolvable components.",
        description="Run repository quality and publish maturity for all resolvable components.",
    )
    verify.add_argument("stage", nargs="?", choices=["pre-alpha", "alpha", "beta", "gamma", "production"])
    verify.set_defaults(func=cmd_verify)

    maturity = subparsers.add_parser("maturity", help="Maturity module commands.")
    maturity_sub = maturity.add_subparsers(dest="command", required=True)

    evaluate = maturity_sub.add_parser("evaluate", help="Evaluate a maturity profile without publishing history.")
    evaluate.add_argument("stage", choices=["pre-alpha", "alpha", "beta", "gamma", "production"])
    evaluate.add_argument("--component", default="sister-core")
    evaluate.add_argument("--component-root", default=str(ROOT))
    evaluate.add_argument("--profile")
    evaluate.add_argument("--engine", choices=["legacy", "declarative", "compare"])
    evaluate.add_argument("--strict", action="store_true")
    evaluate.set_defaults(func=cmd_maturity_evaluate)

    publish = maturity_sub.add_parser("publish", help="Evaluate and publish maturity status/history.")
    publish.add_argument("stage", nargs="?", choices=["pre-alpha", "alpha", "beta", "gamma", "production"])
    publish.add_argument("--component", default="sister-core")
    publish.add_argument("--component-root")
    publish.add_argument("--engine", choices=["legacy", "declarative", "compare"])
    publish.set_defaults(func=cmd_maturity_publish)

    publish_all = maturity_sub.add_parser("publish-all", help="Evaluate and publish all resolvable ecosystem components.")
    publish_all.add_argument("stage", nargs="?", choices=["pre-alpha", "alpha", "beta", "gamma", "production"])
    publish_all.add_argument("--engine", choices=["legacy", "declarative", "compare"])
    publish_all.set_defaults(func=cmd_maturity_publish_all)

    components = maturity_sub.add_parser("components", help="Rebuild the federated components index.")
    components.set_defaults(func=cmd_maturity_components)

    validate = maturity_sub.add_parser("validate", help="Validate maturity contracts or a status JSON.")
    validate.add_argument("--status-json")
    validate.set_defaults(func=cmd_maturity_validate)

    plan = subparsers.add_parser("plan", help="Planejamento evolutivo governado.")
    plan.add_argument("--json", action="store_true", help="Emitir saída estruturada.")
    plan_sub = plan.add_subparsers(dest="command", required=True)
    for command, help_text in (("status", "Mostrar o plano vigente."), ("gaps", "Listar lacunas."), ("list", "Listar ações.")):
        item = plan_sub.add_parser(command, help=help_text)
        item.add_argument("--json", action="store_true", help="Emitir saída estruturada.")
        item.set_defaults(func=cmd_plan)
    for command, help_text in (("show", "Mostrar uma ação."), ("explain", "Explicar uma ação.")):
        item = plan_sub.add_parser(command, help=help_text)
        item.add_argument("action_id")
        item.add_argument("--json", action="store_true", help="Emitir saída estruturada.")
        item.set_defaults(func=cmd_plan)
    assess = plan_sub.add_parser("assess", help="Avaliar e recomendar prioridade.")
    assess.add_argument("action_id")
    assess.add_argument("--persist", action="store_true")
    assess.add_argument("--json", action="store_true")
    assess.set_defaults(func=cmd_plan)
    decision = plan_sub.add_parser("decision", help="Registrar decisão humana.")
    decision_sub = decision.add_subparsers(dest="decision_command", required=True)
    record = decision_sub.add_parser("record", help="Registrar decisão a partir de JSON.")
    record.add_argument("path")
    record.add_argument("--json", action="store_true")
    record.set_defaults(func=cmd_plan)
    transition = plan_sub.add_parser("transition", help="Aplicar transição autorizada.")
    transition.add_argument("action_id")
    transition.add_argument("state")
    transition.add_argument("--decision-id")
    transition.add_argument("--json", action="store_true")
    transition.set_defaults(func=cmd_plan)

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
