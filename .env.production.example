# Exemplo de configuração para produção
# Este arquivo deve ser copiado para /etc/sister/sister.env no servidor de produção
# e protegido com permissões restritas (ex: chmod 600, root:root)

# URL de conexão com o banco de dados
SISTER_DATABASE_URL=postgresql://usuario_real:senha_real@localhost:5432/sister_prod

# Integrações internas permanecem desabilitadas até ativação shadow governada.
SISTER_ENABLE_NEXO_SIGNED_INTEGRATION=false

# Caminhos canônicos do pacote e do estado. O SEC-03V-ENV exige estes valores.
SISTER_WEB_ROOT=/opt/sister/web
SISTER_MATURITY_ROOT=/var/lib/sister/maturity

# Preencha somente no host candidato, depois de gerar a chave local protegida.
SISTER_INTERNAL_IDENTITY_PRIVATE_KEY_FILE=/etc/sister/identity-private.pem
SISTER_INTERNAL_IDENTITY_KEY_ID=defina-o-kid-governado
SISTER_INTERNAL_IDENTITY_TTL_SECONDS=60
SISTER_NEXO_PORT=8015

# Outras credenciais podem ser adicionadas aqui
# SISTER_API_KEY=...
