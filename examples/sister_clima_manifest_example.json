{
  "system_id": "sister_clima",
  "system_name": "Sister-Clima",
  "system_version": "2.3.0",
  "contract_version": "sister-contracts/0.1.0",
  "type": "climate_monitoring_system",
  "domain": ["clima", "precipitacao", "resiliencia", "inteligencia_territorial"],
  "operational_mode": ["local_web", "public_web", "scheduled_collection", "offline_dataset"],
  "exports": ["daily_precipitation_csv", "climate_indicators", "spatial_precipitation_layer", "provenance_metadata"],
  "integration_modes": ["platform_link", "file_import"],
  "responsible_repository": "Sister-Clima",
  "access": {
    "platform_url": "http://127.0.0.1:8501",
    "access_label": "Abrir Sister-Clima",
    "access_mode": "restricted_link"
  },
  "sharing_policy": {
    "shareable_with_sister": ["reviewed_climate_indicators", "exported_spatial_layers", "source_provenance", "dataset_temporal_coverage"],
    "native_to_system": ["interactive_climate_explorer", "intra_municipal_surface_generation", "source_selection", "raw_api_responses"],
    "public_outputs": ["application_documentation", "source_links", "provenance_metadata"],
    "restricted_outputs": ["open_meteo_derived_datasets", "unreviewed_climate_indicators", "generated_spatial_layers"],
    "private_outputs": ["session_parameters", "network_configuration", "runtime_logs"],
    "sensitive_topics": ["extreme_weather_decision_support", "source_license_restrictions"],
    "dikw_role": {
      "offers_as_information": ["precipitation_time_series", "rainfall_indicators", "spatial_precipitation_estimates"],
      "received_by_sister_as": "data",
      "sister_transforms_into": ["information", "knowledge", "wisdom"]
    }
  },
  "data_policy": {
    "requires_provenance": true,
    "allows_offline_sync": true,
    "requires_schema_validation": true,
    "requires_operator": true,
    "requires_spatial_reference": true
  }
}
