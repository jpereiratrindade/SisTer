{
  "schema": "sister.subsystem.manifest/1.0.0",
  "system_id": "sister_reference",
  "name": "SisTer Reference Subsystem",
  "version": "0.1.0",
  "contract": "sister.subsystem/1.0.0",
  "adapter_version": "1.0.0",
  "mount_path": "/integrations/reference/",
  "audience": "sister_reference",
  "transport": {
    "http": true,
    "websocket": false,
    "internal_endpoint": "http://127.0.0.1:19001"
  },
  "technical_endpoints": {
    "manifest": "/manifest",
    "health": "/health",
    "readiness": "/ready",
    "capabilities": "/capabilities",
    "identity": "/identity",
    "echo": "/echo"
  },
  "capabilities": [
    "reference.identity.read",
    "reference.echo.execute"
  ],
  "capability_offers": [
    {
      "capability": "reference.echo.execute",
      "method": "POST",
      "endpoint": "/echo",
      "input": {"schema": "sister.echo.request/1.0.0", "fields": ["value"]},
      "output": {"schema": "sister.subsystem.echo/1.0.0", "fields": ["value", "processed_by"]},
      "observable_success": "output.value equals input.value and output.processed_by equals sister_reference"
    }
  ],
  "data_ownership": "external_reference",
  "audit_level": "all_state_changes",
  "production_eligible": false
}
