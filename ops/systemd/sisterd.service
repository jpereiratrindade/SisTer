[Unit]
Description=Servidor SisTer (Produção)
Requires=sisterd.socket
After=sisterd.socket network.target postgresql.service

[Service]
Type=simple
# Substitua 'sister' pelo usuário real do sistema que vai rodar a aplicação
User=sister
Group=sister

# O diretório raiz onde o código está baixado
WorkingDirectory=/opt/sister

# Carrega variáveis de ambiente de um arquivo protegido com permissões 600
EnvironmentFile=/etc/sister/sister.env

# Variáveis de ambiente de configuração geral (sem credenciais)
Environment=SISTER_ENV=production
Environment=SISTER_LISTENER_MODE=systemd-unix
Environment=SISTER_ACTIVATED_SOCKET_PATH=/run/sister/sisterd.sock
Environment=SISTER_COOKIE_SECURE=true
Environment=SISTER_ENABLE_HTTP_BOOTSTRAP=false
Environment=SISTER_ENABLE_LEGACY_PROXY=false
Environment=SISTER_ENABLE_LEGACY_WEBSOCKET_PROXY=false
Environment=SISTER_ENABLE_NEXO_SIGNED_INTEGRATION=false
Environment=SISTER_AUTH_FILE=/var/lib/sister/auth-users.tsv

# Diretório persistente criado e protegido pelo systemd para o usuário do serviço
StateDirectory=sister
StateDirectoryMode=0700

# Comando que inicia o sistema
ExecStart=/opt/sister/build/apps/sisterd/sisterd

# Regras de reinício automático
Restart=always
RestartSec=5

# Sandbox do plano de controle
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_UNIX
SystemCallArchitectures=native
UMask=0077

# Limites a ajustar somente com evidência de carga
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
